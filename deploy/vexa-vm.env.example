VEXA_BIND=127.0.0.1:8080
VEXA_PUBLIC_URL=https://vm.example.com
VEXA_DATABASE=/var/lib/vexa-vm/vexa.db
VEXA_TEMPLATE_DIR=/opt/vexa-vm/current/templates
VEXA_STATIC_DIR=/opt/vexa-vm/current/static
VEXA_SECURE_COOKIES=true
VEXA_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
VEXA_BOOTSTRAP_ADMIN=admin
VEXA_BOOTSTRAP_PASSWORD=REPLACE_ON_FIRST_START
VEXA_HYPERVISOR=auto
VEXA_LIBVIRT_URI=qemu:///system
VEXA_VM_STORAGE=/var/lib/libvirt/images/vexa-vm
VEXA_ISO_STORAGE=/var/lib/vexa-vm/isos
VEXA_CLOUD_INIT_STORAGE=/var/lib/vexa-vm/cloud-init
VEXA_GUEST_TOOLS_SOCKET_DIR=/var/lib/vexa-vm/guest-tools
VEXA_GUEST_TOOLS_LINUX_X86_64_ARTIFACT=/opt/vexa-vm/current/guest-tools/vexa-guest-tools-linux-x86_64
VEXA_GUEST_TOOLS_WINDOWS_X86_64_ARTIFACT=/opt/vexa-vm/current/guest-tools/vexa-guest-tools-windows-x86_64.exe
# Set VEXA_GUEST_TOOLS_VERSION only when the two artifact paths above point to
# administrator-managed binaries whose version differs from Vexa-VM itself.
VEXA_NETWORK_BRIDGE=virbr0
VEXA_VNC_TTL_SECONDS=600
VEXA_METRICS_INTERVAL_SECONDS=15
VEXA_LOG=info
